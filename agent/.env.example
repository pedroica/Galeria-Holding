# ============================================================================
# Agente Outbound Galeria — variáveis de ambiente (TODAS as fases)
# Copie para .env e preencha. NUNCA commite o .env real.
# Legenda:  [0] Fase Blocklist  [1] Lusha  [2] Gmail  [3] WhatsApp  [4] Cron/Dash
# ============================================================================

# ── GERAL / GUARDRAILS ──────────────────────────────────────────────────────
NODE_ENV=development
TIMEZONE=America/Sao_Paulo
DRY_RUN=true                     # true = só loga o que faria. Vira false só com seu OK.
AGENT_PAUSED=false               # kill switch global (o dashboard também controla)

# ── [0][1][4] SUPABASE (fonte única da verdade) ─────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...          # usada pelo CRM (frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # usada pelo worker (server-only, NUNCA no frontend)

# ── [1] LUSHA (enriquecimento) ──────────────────────────────────────────────
LUSHA_API_KEY=
LUSHA_DAILY_LIMIT=60             # créditos/dia; para e avisa no Telegram se estourar

# ── [2] GMAIL API (OAuth) — 50 rascunhos/dia em pedro.ica@galeriaholding.co ──
# Reaproveite o projeto Google Cloud que já tem OAuth de Sheets. Escopos:
#   gmail.compose (rascunhos), gmail.readonly (detecção de resposta),
#   contacts (People API — Fase 3).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=      # eu te guio no fluxo pra gerar este token
GMAIL_SENDER=pedro.ica@galeriaholding.co
EMAIL_DAILY_MAX=50

# ── [3] WHATSAPP — provider selecionável (adapter pattern) ──────────────────
WHATSAPP_PROVIDER=evolution      # evolution | cloud

#   a) Evolution API (self-hosted Railway, SEU número) — PRIMÁRIO
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=galeria
EVOLUTION_SENDER_NUMBER=         # +55...

#   b) WhatsApp Cloud API (oficial) — fallback
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=           # segredo do webhook (você inventa)

#   Guardrails de segurança do número (defaults conforme brief)
WHATSAPP_DAILY_MAX=25
WHATSAPP_RAMP=5,10,15,25         # rampa progressiva (dia 1..4 da 1ª semana)
WHATSAPP_MIN_INTERVAL_MIN=4
WHATSAPP_MAX_INTERVAL_MIN=9
WHATSAPP_WINDOW_START=9          # hora local (America/Sao_Paulo)
WHATSAPP_WINDOW_END=18
WHATSAPP_DAYS=mon,tue,wed,thu,fri

# ── [3][4] TELEGRAM (bot @Galeria_prospeccao_bot) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                # seu chat id — eu te mostro como pegar (/start no bot)

# ── [4] CRON / WORKER (Railway) ─────────────────────────────────────────────
CRON_DAILY=30 7 * * *            # 7h30 America/Sao_Paulo
PUBLIC_WEBHOOK_BASE_URL=         # URL pública do worker (webhooks WA/Gmail)
