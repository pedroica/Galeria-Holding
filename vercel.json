{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": { "runtime": "nodejs20.x" }
  },
  "crons": [
    {
      "path": "/api/cron/agent-daily",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron/gerar-fila-diario",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/noticias-semanal",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/enriquecimento-diario",
      "schedule": "30 13 * * *"
    },
    {
      "path": "/api/cron/fechamento-sexta",
      "schedule": "0 20 * * 5"
    }
  ]
}
