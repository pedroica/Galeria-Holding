{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": ".",
  "functions": {
    "api/cron.js": {
      "maxDuration": 60
    },
    "api/copiloto.js": {
      "maxDuration": 55
    },
    "api/crm-backup.js": {
      "maxDuration": 60
    },
    "api/enrich.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/c/:token",
      "destination": "/api/fila?token=:token"
    },
    {
      "source": "/api/relatorio/:token",
      "destination": "/api/fila?action=relatorio&token=:token"
    },
    {
      "source": "/api/whatsapp",
      "destination": "/api/enrich?provider=whatsapp"
    },
    {
      "source": "/api/gerar-fila",
      "destination": "/api/fila"
    },
    {
      "source": "/api/gerar-credencial",
      "destination": "/api/fila?action=credencial"
    },
    {
      "source": "/api/crawl",
      "destination": "/api/enrich?provider=crawl"
    },
    {
      "source": "/api/claude",
      "destination": "/api/enrich?provider=claude"
    },
    {
      "source": "/api/gaia-board",
      "destination": "/api/enrich?provider=gaia-board"
    }
  ],
  "crons": [
    { "path": "/api/cron?job=enriquecimento-diario",   "schedule": "0 8 * * *"   },
    { "path": "/api/cron?job=noticias-semanal",        "schedule": "0 7 * * 1-5"  },
    { "path": "/api/cron?job=rascunhos-matinais",      "schedule": "0 10 * * 1-5" },
    { "path": "/api/cron?job=oportunidades-paradas",   "schedule": "0 11 * * 1" },
    { "path": "/api/cron?job=fechamento-sexta",        "schedule": "0 20 * * 5"  },
    { "path": "/api/crm-backup",                       "schedule": "0 2 * * *"   }
  ]
}
